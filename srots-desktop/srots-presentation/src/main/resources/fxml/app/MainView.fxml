<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import com.srots.presentation.components.navigation.sidebar.SrotsSidebar?>
<?import com.srots.presentation.components.navigation.topbar.SrotsTopBar?>
<?import com.srots.presentation.components.navigation.topbar.SrotsStatusBar?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.srots.presentation.app.MainViewController"
            styleClass="srots-shell, srots-app, srots-main-window, srots-app-shell"
            prefWidth="1280" prefHeight="820">

    <!-- TopBar -->
    <top>
        <SrotsTopBar fx:id="topBar"/>
    </top>

    <!-- Sidebar -->
    <left>
        <SrotsSidebar fx:id="sidebar" prefWidth="260"/>
    </left>

    <!-- Content Area -->
    <center>
        <VBox styleClass="srots-content-region" spacing="12">
            <padding>
                <Insets top="16" right="24" bottom="24" left="24"/>
            </padding>
            <StackPane fx:id="contentArea" styleClass="srots-content, srots-content-host" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>

    <!-- Status Bar -->
    <bottom>
        <SrotsStatusBar fx:id="statusBar"/>
    </bottom>

</BorderPane>
